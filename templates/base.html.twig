<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Itransition Project{% endblock %}</title>
        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body>
        <header class="bg-body-tertiary border-bottom">
        <nav class="navbar" aria-label="Main navigation">
            <div class="container d-flex flex-wrap gap-3">
                <a class="navbar-brand" href="{{ path('app_home') }}">Itransition Project</a>
                <form action="{{ path('app_search') }}" method="get" role="search" class="d-flex flex-grow-1" style="max-width: 24rem">
                    <label class="visually-hidden" for="site-search">Search</label>
                    <input id="site-search" class="form-control form-control-sm me-2" type="search" name="q" maxlength="200" placeholder="Search positions and CVs" value="{{ app.request.query.get('q') is same as(null) ? '' : app.request.query.get('q') }}">
                    <button class="btn btn-outline-primary btn-sm" type="submit">Search</button>
                </form>
                <div class="ms-auto d-flex flex-wrap align-items-center gap-3">
                    <a class="nav-link" href="{{ path('app_positions_index') }}">Positions</a>
                    {% if app.user %}
                        {% if is_granted('ROLE_CANDIDATE') %}
                            <a class="nav-link" href="{{ path('app_profile') }}">Profile</a>
                            <a class="nav-link" href="{{ path('app_projects_index') }}">Projects</a>
                            <a class="nav-link" href="{{ path('app_cv_index') }}">CVs</a>
                        {% endif %}
                        {% if is_granted('ROLE_RECRUITER') or is_granted('ROLE_ADMIN') %}<a class="nav-link" href="{{ path('app_attributes_index') }}">Attribute Library</a>{% endif %}
                        <span class="text-body-secondary">{{ app.user.email }}</span>
                        <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_logout') }}">Logout</a>
                    {% else %}
                        <a class="btn btn-outline-primary btn-sm" href="{{ path('app_login') }}">Login</a>
                    {% endif %}
                </div>
            </div>
        </nav>
        </header>
        {% block body %}{% endblock %}
    </body>
</html>
