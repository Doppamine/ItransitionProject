{% extends 'base.html.twig' %}

{% block title %}{{ name }} · {{ 'ui.candidate_profile'|trans }}{% endblock %}

{% block body %}
<main class="container py-4 py-lg-5">
    <a href="{{ path('app_positions_index') }}" class="d-inline-block mb-3">{{ 'ui.back_positions'|trans }}</a>
    <header class="border-bottom pb-3 mb-4">
        <p class="small text-uppercase text-primary fw-semibold mb-1">{{ 'ui.candidate_profile'|trans }}</p>
        <h1 class="h2 mb-2">{{ name }}</h1>
        {% if location %}<p class="text-body-secondary mb-0">{{ location }}</p>{% endif %}
    </header>
    <section aria-labelledby="public-projects"><h2 id="public-projects" class="h4 mb-3">{{ 'ui.projects'|trans }}</h2>
        {% for project in projects %}
            <article class="card mb-3"><div class="card-body">
                <h3 class="h6">{{ project.name }}</h3>
                <p class="small text-body-secondary">{{ project.startDate|date('Y-m-d') }} – {{ project.endDate ? project.endDate|date('Y-m-d') : 'dynamic.present'|trans }}</p>
                <div class="mb-0">{{ project.description|safe_markdown }}</div>
            </div></article>
        {% else %}<p class="text-body-secondary">{{ 'ui.no_projects_shared'|trans }}</p>{% endfor %}
    </section>
</main>
{% endblock %}
