<div class="rounded-3 p-3 mb-3 {{ item.missing ? 'border border-danger bg-danger-subtle' : 'border bg-body' }}">
    {% if item.missing %}<span class="badge text-bg-danger float-end">{{ 'ui.missing'|trans }}</span>{% endif %}
    {% if editable %}
        {% include 'profile/_editor.html.twig' with {definition: item.definition, value: item.value, imageScope: 'cv', imageTargetId: cvId} only %}
    {% else %}
        <div class="fw-semibold mb-1">{{ item.definition.name }}</div>
        {% if item.missing %}
            <div class="text-danger fw-semibold">{{ 'ui.missing_value'|trans }}</div>
        {% else %}
            {% if item.definition.type.value == 'image' and item.value and cloudinary_image_url(item.value.imageKey) %}
                <img src="{{ cloudinary_image_url(item.value.imageKey) }}" alt="{{ item.definition.name }}" class="img-fluid rounded-3 profile-image-preview" loading="lazy">
            {% elseif item.definition.type.value == 'image' %}
                <div class="text-body-secondary">{{ 'image.unavailable'|trans }}</div>
            {% elseif item.definition.type.value == 'boolean' %}
                <div>{{ (item.value.booleanValue ? 'common.yes' : 'common.no')|trans }}</div>
            {% elseif item.definition.type.value == 'text' %}
                <div>{{ item.display|safe_markdown }}</div>
            {% else %}<div style="white-space: pre-wrap">{{ item.display }}</div>{% endif %}
        {% endif %}
    {% endif %}
</div>
