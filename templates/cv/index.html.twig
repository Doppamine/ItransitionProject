{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.my_cvs'|trans }} · Itransition Project{% endblock %}

{% block body %}
<main class="container py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><p class="small text-uppercase text-primary fw-semibold mb-1">{{ 'ui.candidate_workspace'|trans }}</p><h1 class="h2 mb-0">{{ 'ui.my_cvs'|trans }}</h1></div>
        <a class="btn btn-outline-primary" href="{{ path('app_positions_index') }}">{{ 'ui.browse_positions'|trans }}</a>
    </div>
    <div class="table-responsive border rounded-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">{{ 'ui.position'|trans }}</th><th scope="col">{{ 'ui.status'|trans }}</th><th scope="col">{{ 'ui.likes'|trans }}</th><th scope="col">{{ 'ui.created'|trans }}</th><th scope="col">{{ 'ui.updated'|trans }}</th><th scope="col"><span class="visually-hidden">{{ 'ui.open'|trans }}</span></th></tr></thead>
            <tbody>
                {% for cv in cvs %}
                    <tr><td>{{ cv.position.title }}</td><td><span class="badge text-bg-{{ cv.status.value == 'PUBLISHED' ? 'success' : 'secondary' }}">{{ ('enum.cv_status.' ~ cv.status.value)|trans }}</span></td><td>{{ likeCounts[cv.id] ?? 0 }}</td><td>{{ cv.createdAt|date('Y-m-d') }}</td><td>{{ cv.updatedAt|date('Y-m-d') }}</td><td class="text-end"><a href="{{ path('app_cv_show', {id: cv.id}) }}">{{ 'ui.open_cv'|trans }}</a></td></tr>
                {% else %}
                    <tr><td colspan="6" class="text-body-secondary py-4">{{ 'ui.no_accessible_cvs'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>
{% endblock %}
