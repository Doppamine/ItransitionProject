{% extends 'base.html.twig' %}

{% block title %}My CVs · Itransition Project{% endblock %}

{% block body %}
<main class="container py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><p class="small text-uppercase text-primary fw-semibold mb-1">Candidate workspace</p><h1 class="h2 mb-0">My CVs</h1></div>
        <a class="btn btn-outline-primary" href="{{ path('app_positions_index') }}">Browse positions</a>
    </div>
    <div class="table-responsive border rounded-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">Position</th><th scope="col">Status</th><th scope="col">Likes</th><th scope="col">Created</th><th scope="col">Updated</th><th scope="col"><span class="visually-hidden">Open</span></th></tr></thead>
            <tbody>
                {% for cv in cvs %}
                    <tr><td>{{ cv.position.title }}</td><td><span class="badge text-bg-{{ cv.status.value == 'PUBLISHED' ? 'success' : 'secondary' }}">{{ cv.status.value|capitalize }}</span></td><td>{{ likeCounts[cv.id] ?? 0 }}</td><td>{{ cv.createdAt|date('Y-m-d') }}</td><td>{{ cv.updatedAt|date('Y-m-d') }}</td><td class="text-end"><a href="{{ path('app_cv_show', {id: cv.id}) }}">Open CV</a></td></tr>
                {% else %}
                    <tr><td colspan="6" class="text-body-secondary py-4">No accessible CVs yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>
{% endblock %}
