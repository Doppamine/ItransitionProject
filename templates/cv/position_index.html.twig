{% extends 'base.html.twig' %}

{% block title %}{{ 'dynamic.cvs_for'|trans({'%position%': position.title}) }} · Itransition Project{% endblock %}

{% block body %}
<main class="container py-4 py-lg-5">
    <a href="{{ path('app_positions_show', {id: position.id}) }}" class="d-inline-block mb-3">{{ 'ui.back_position'|trans }}</a>
    <h1 class="h2 mb-4">{{ 'dynamic.cvs_for'|trans({'%position%': position.title}) }}</h1>
    <div class="table-responsive border rounded-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">{{ 'ui.candidate'|trans }}</th><th scope="col">{{ 'ui.status'|trans }}</th><th scope="col">{{ 'ui.likes'|trans }}</th><th scope="col">{{ 'ui.created'|trans }}</th><th scope="col">{{ 'ui.updated'|trans }}</th><th scope="col"><span class="visually-hidden">{{ 'ui.open'|trans }}</span></th></tr></thead>
            <tbody>
                {% for cv in cvs %}
                    <tr><td>{{ cv.profile.user.email }}</td><td><span class="badge text-bg-{{ cv.status.value == 'PUBLISHED' ? 'success' : 'secondary' }}">{{ ('enum.cv_status.' ~ cv.status.value)|trans }}</span></td><td>{{ likeCounts[cv.id] ?? 0 }}</td><td>{{ cv.createdAt|date('Y-m-d') }}</td><td>{{ cv.updatedAt|date('Y-m-d') }}</td><td class="text-end"><a href="{{ path('app_cv_show', {id: cv.id}) }}">{{ 'ui.open_cv'|trans }}</a></td></tr>
                {% else %}
                    <tr><td colspan="6" class="text-body-secondary py-4">{{ 'ui.no_visible_cvs'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>
{% endblock %}
