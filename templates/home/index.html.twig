{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }} · Itransition Project{% endblock %}

{% block body %}
<main class="container py-4 py-lg-5">
    <div class="mb-4">
        <h1 class="h2 mb-1">{{ 'home.title'|trans }}</h1>
        <p class="text-body-secondary mb-0">{{ 'home.intro'|trans }}</p>
    </div>

    <section class="mb-5" aria-labelledby="latest-heading">
        <h2 id="latest-heading" class="h4 mb-3">{{ 'home.latest'|trans }}</h2>
        <div id="latest-positions" class="table-responsive border rounded-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th scope="col">{{ 'common.position'|trans }}</th><th scope="col">{{ 'common.access'|trans }}</th><th scope="col">{{ 'common.updated'|trans }}</th></tr></thead>
                <tbody>
                    {% for position in latest %}
                        <tr><td><a href="{{ path('app_positions_show', {id: position.id}) }}">{{ position.title }}</a></td><td>{{ ('enum.access.' ~ position.accessType.value)|trans }}</td><td>{{ position.updatedAt|date('Y-m-d') }}</td></tr>
                    {% else %}
                        <tr><td colspan="3" class="text-body-secondary py-4">{{ 'home.no_positions'|trans }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="mb-5" aria-labelledby="popular-heading">
        <h2 id="popular-heading" class="h4 mb-3">{{ 'home.popular'|trans }}</h2>
        <div id="popular-positions" class="table-responsive border rounded-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th scope="col">{{ 'common.position'|trans }}</th><th scope="col">{{ 'home.submitted_cvs'|trans }}</th><th scope="col">{{ 'common.updated'|trans }}</th></tr></thead>
                <tbody>
                    {% for row in popular %}
                        <tr><td><a href="{{ path('app_positions_show', {id: row.position.id}) }}">{{ row.position.title }}</a></td><td>{{ row.count }}</td><td>{{ row.position.updatedAt|date('Y-m-d') }}</td></tr>
                    {% else %}
                        <tr><td colspan="3" class="text-body-secondary py-4">{{ 'home.no_positions'|trans }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="mb-5" aria-labelledby="tags-heading">
        <h2 id="tags-heading" class="h4 mb-3">{{ 'home.tags'|trans }}</h2>
        {% if tags %}
            <div class="border rounded-3 p-3 d-flex flex-wrap align-items-center gap-3">
                {% for tag in tags %}<a href="{{ path('app_tag_show', {id: tag.id}) }}" data-weight="{{ tag.weight }}" class="link-primary text-decoration-none fw-semibold fs-{{ 7 - tag.size }}">{{ tag.name }}</a>{% endfor %}
            </div>
        {% else %}
            <p class="text-body-secondary">{{ 'home.no_tags'|trans }}</p>
        {% endif %}
    </section>

    <section aria-labelledby="stats-heading">
        <h2 id="stats-heading" class="h4 mb-3">{{ 'home.statistics'|trans }}</h2>
        <div class="row row-cols-2 row-cols-lg-5 g-3">
            <div class="col"><div class="border rounded-3 p-3 h-100"><div id="stat-cvs-24h" class="h3 mb-1">{{ statistics.cvs24h }}</div><div class="small text-body-secondary">{{ 'home.cvs_24h'|trans }}</div></div></div>
            <div class="col"><div class="border rounded-3 p-3 h-100"><div id="stat-total-positions" class="h3 mb-1">{{ statistics.positions }}</div><div class="small text-body-secondary">{{ 'home.total_positions'|trans }}</div></div></div>
            <div class="col"><div class="border rounded-3 p-3 h-100"><div id="stat-candidates" class="h3 mb-1">{{ statistics.candidates }}</div><div class="small text-body-secondary">{{ 'home.candidates'|trans }}</div></div></div>
            <div class="col"><div class="border rounded-3 p-3 h-100"><div id="stat-recruiters" class="h3 mb-1">{{ statistics.recruiters }}</div><div class="small text-body-secondary">{{ 'home.recruiters'|trans }}</div></div></div>
            <div class="col"><div class="border rounded-3 p-3 h-100"><div id="stat-submitted-cvs" class="h3 mb-1">{{ statistics.submitted }}</div><div class="small text-body-secondary">{{ 'home.submitted_cvs'|trans }}</div></div></div>
        </div>
    </section>
</main>
{% endblock %}
