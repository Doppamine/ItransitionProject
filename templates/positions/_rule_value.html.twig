{% macro expected(rule) %}
    {% set type = rule.definition.type.value %}
    {% if type in ['string', 'text'] %}{{ rule.textValue }}
    {% elseif type == 'numeric' %}{{ rule.numericValue }}
    {% elseif type == 'date' %}{{ rule.dateValue|date('Y-m-d') }}
    {% elseif type == 'period' %}{{ rule.periodStart|date('Y-m-d') }} – {{ rule.periodEnd|date('Y-m-d') }}
    {% elseif type == 'boolean' %}{{ (rule.booleanValue ? 'common.yes' : 'common.no')|trans }}
    {% elseif type == 'select' %}{{ rule.option.label }}
    {% endif %}
{% endmacro %}
