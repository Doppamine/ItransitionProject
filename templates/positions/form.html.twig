{% extends 'base.html.twig' %}
{% import 'positions/_rule_value.html.twig' as rule_value %}

{% block title %}{{ (position ? 'ui.edit_position' : 'ui.new_position')|trans }} · Itransition Project{% endblock %}

{% block body %}
<main class="container py-4 py-lg-5">
    <a href="{{ path('app_positions_index') }}" class="d-inline-block mb-3">{{ 'ui.back_positions'|trans }}</a>
    <h1 class="h2 mb-4">{{ (position ? 'ui.edit_position' : 'ui.new_position')|trans }}</h1>
    {% for message in app.flashes('success') %}<div class="alert alert-success" role="status">{{ message|trans }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="alert alert-danger" role="alert">{{ message|trans }}</div>{% endfor %}
    <section class="card mb-4"><div class="card-body">
        {{ form_start(form) }}{{ form_errors(form) }}
        <div class="row g-3"><div class="col-12">{{ form_row(form.title) }}</div><div class="col-12">{{ form_row(form.shortDescription) }}</div><div class="col-md-6">{{ form_row(form.accessType) }}</div><div class="col-md-6">{{ form_row(form.maxProjects) }}</div></div>
        <button class="btn btn-primary mt-3" type="submit">{{ 'ui.save_position'|trans }}</button>
        {{ form_end(form) }}
    </div></section>

    {% if position %}
        <div class="row g-4">
            <section class="col-lg-7"><div class="card h-100"><div class="card-body"><h2 class="h5">{{ 'ui.template_attributes'|trans }}</h2>
                <form method="get" action="{{ path('app_positions_edit', {id: position.id}) }}" class="row g-2 mb-3">
                    <div class="col-sm-5"><label class="form-label" for="template-attribute-q">{{ 'ui.name_starts_with'|trans }}</label><input id="template-attribute-q" class="form-control" name="attribute_q" value="{{ attributeQuery }}" maxlength="255"></div>
                    <div class="col-sm-5"><label class="form-label" for="template-attribute-category">{{ 'ui.category'|trans }}</label><select id="template-attribute-category" class="form-select" name="attribute_category"><option value="">{{ 'ui.all_categories'|trans }}</option>{% for category in categories %}<option value="{{ category.id }}"{{ attributeCategory == category.id ? ' selected' : '' }}>{{ category.name }}</option>{% endfor %}</select></div>
                    <div class="col-sm-2 align-self-end"><button class="btn btn-outline-secondary w-100" type="submit">{{ 'ui.find'|trans }}</button></div>
                </form>
                <form method="post" action="{{ path('app_positions_attribute_add', {id: position.id}) }}" class="row g-2 mb-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('position_child_' ~ position.id) }}"><input type="hidden" name="version" value="{{ position.version }}">
                    <div class="col-sm-7"><select class="form-select" name="definition" required><option value="">{{ 'ui.choose_attribute'|trans }}</option>{% if recent %}<optgroup label="{{ 'attributes.recent'|trans }}">{% for definition in recent %}<option value="{{ definition.id }}">{{ definition.name }}</option>{% endfor %}</optgroup>{% endif %}<optgroup label="{{ 'attributes.all'|trans }}">{% for definition in definitions %}<option value="{{ definition.id }}">{{ definition.name }}</option>{% endfor %}</optgroup></select></div>
                    <div class="col-sm-3"><input class="form-control" type="number" min="0" name="sortOrder" value="{{ position.attributes|length * 10 + 10 }}" aria-label="{{ 'dynamic.sort_order'|trans }}" required></div>
                    <div class="col-sm-2"><button class="btn btn-outline-primary w-100" type="submit">{{ 'ui.add'|trans }}</button></div>
                </form>
                <p class="small text-body-secondary">{{ 'ui.attributes_limit'|trans }}</p>
                {% for item in position.attributes %}<div class="d-flex gap-2 align-items-center border-top py-2"><span class="flex-grow-1">{{ item.definition.name }}</span>
                    <form class="d-flex gap-2" method="post" action="{{ path('app_positions_attribute_order', {id: position.id, childId: item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('position_child_' ~ position.id) }}"><input type="hidden" name="version" value="{{ position.version }}"><input class="form-control form-control-sm" style="width:6rem" type="number" min="0" name="sortOrder" value="{{ item.sortOrder }}" aria-label="{{ 'dynamic.sort_order'|trans }}"><button class="btn btn-outline-secondary btn-sm">{{ 'ui.order'|trans }}</button></form>
                    <form method="post" action="{{ path('app_positions_attribute_remove', {id: position.id, childId: item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('position_child_' ~ position.id) }}"><input type="hidden" name="version" value="{{ position.version }}"><button class="btn btn-outline-danger btn-sm">{{ 'ui.remove'|trans }}</button></form>
                </div>{% else %}<p class="text-body-secondary">{{ 'ui.no_template_attributes'|trans }}</p>{% endfor %}
            </div></div></section>
            <section class="col-lg-5"><div class="card h-100"><div class="card-body"><h2 class="h5">{{ 'ui.relevant_project_tags'|trans }}</h2>
                <form method="post" action="{{ path('app_positions_tag_add', {id: position.id}) }}" class="d-flex flex-wrap gap-2 mb-3"><input type="hidden" name="_token" value="{{ csrf_token('position_child_' ~ position.id) }}"><input type="hidden" name="version" value="{{ position.version }}"><input class="form-control flex-grow-1" style="min-width: 10rem" list="position-tags" name="tag" placeholder="{{ 'dynamic.existing_tag_placeholder'|trans }}" required><datalist id="position-tags">{% for tag in availableTags %}<option value="{{ tag.name }}">{% endfor %}</datalist><button class="btn btn-outline-primary">{{ 'ui.add'|trans }}</button></form>
                {% for link in position.projectTagLinks %}<div class="d-flex justify-content-between align-items-center border-top py-2"><span class="badge text-bg-secondary">{{ link.tag.name }}</span><form method="post" action="{{ path('app_positions_tag_remove', {id: position.id, childId: link.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('position_child_' ~ position.id) }}"><input type="hidden" name="version" value="{{ position.version }}"><button class="btn btn-outline-danger btn-sm">{{ 'ui.remove'|trans }}</button></form></div>{% else %}<p class="text-body-secondary">{{ 'ui.no_relevant_tags'|trans }}</p>{% endfor %}
                <p class="small text-body-secondary mt-3 mb-0">{{ 'ui.tags_limit'|trans }}</p>
            </div></div></section>
        </div>
        <section class="card mt-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">{{ 'ui.access_rules'|trans }}</h2><a class="btn btn-outline-primary btn-sm" href="{{ path('app_positions_rule_new', {id: position.id}) }}">{{ 'ui.add_rule'|trans }}</a></div>
            {% for rule in position.accessRules %}<div class="d-flex justify-content-between align-items-center border-top py-2 mt-3"><span><strong>{{ rule.definition.name }}</strong> — {{ ('enum.operator.' ~ rule.operator.value)|trans }} <span class="text-body-secondary">{{ rule_value.expected(rule) }}</span></span><form method="post" action="{{ path('app_positions_rule_remove', {id: position.id, ruleId: rule.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('position_child_' ~ position.id) }}"><input type="hidden" name="version" value="{{ position.version }}"><button class="btn btn-outline-danger btn-sm">{{ 'ui.remove'|trans }}</button></form></div>{% else %}<p class="text-body-secondary mt-3 mb-0">{{ 'ui.no_access_rules_restricted'|trans }}</p>{% endfor %}
        </div></section>
        <div class="d-flex flex-wrap gap-2 mt-4"><form method="post" action="{{ path('app_positions_duplicate', {id: position.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('position_duplicate_' ~ position.id) }}"><button class="btn btn-outline-primary">{{ 'ui.duplicate_position'|trans }}</button></form><form method="post" action="{{ path('app_positions_delete', {id: position.id}) }}" onsubmit="return confirm({{ 'dynamic.delete_position_confirm'|trans|json_encode|raw }})"><input type="hidden" name="_token" value="{{ csrf_token('position_delete_' ~ position.id) }}"><button class="btn btn-outline-danger">{{ 'ui.delete_position'|trans }}</button></form></div>
    {% endif %}
</main>
{% endblock %}
