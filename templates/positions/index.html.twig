{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.positions'|trans }} · Itransition Project{% endblock %}

{% block body %}
<main class="container py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <div><h1 class="h2 mb-1">{{ 'ui.positions'|trans }}</h1><p class="text-body-secondary mb-0">{{ 'ui.available_cv_templates'|trans }}</p></div>
        {% if manager %}<a class="btn btn-primary" href="{{ path('app_positions_new') }}">{{ 'ui.new_position'|trans }}</a>{% endif %}
    </div>
    {% for message in app.flashes('success') %}<div class="alert alert-success" role="status">{{ message|trans }}</div>{% endfor %}
    <div class="table-responsive border rounded bg-body">
        <table class="table table-striped align-middle mb-0">
            <thead><tr><th scope="col">{{ 'ui.title'|trans }}</th><th scope="col">{{ 'ui.access'|trans }}</th><th scope="col">{{ 'ui.attributes'|trans }}</th><th scope="col">{{ 'ui.project_limit'|trans }}</th><th scope="col">{{ 'ui.updated'|trans }}</th>{% if manager %}<th scope="col"><span class="visually-hidden">{{ 'ui.actions'|trans }}</span></th>{% endif %}</tr></thead>
            <tbody>
            {% for position in positions %}
                <tr>
                    <td><a href="{{ path('app_positions_show', {id: position.id}) }}">{{ position.title }}</a></td>
                    <td>{{ ('enum.access.' ~ position.accessType.value)|trans }}</td>
                    <td>{{ position.attributes|length }}</td>
                    <td>{{ position.maxProjects }}</td>
                    <td>{{ position.updatedAt|date('Y-m-d') }}</td>
                    {% if manager %}<td class="text-end"><a class="btn btn-outline-primary btn-sm" href="{{ path('app_positions_edit', {id: position.id}) }}">{{ 'ui.edit'|trans }}</a></td>{% endif %}
                </tr>
            {% else %}
                <tr><td colspan="{{ manager ? 6 : 5 }}" class="text-center text-body-secondary py-4">{{ 'ui.no_positions'|trans }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="small text-body-secondary mt-2">{{ 'ui.positions_limit'|trans }}</p>
</main>
{% endblock %}
