{% extends 'base.html.twig' %}

{% block title %}Positions · Itransition Project{% endblock %}

{% block body %}
<main class="container py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <div><h1 class="h2 mb-1">Positions</h1><p class="text-body-secondary mb-0">Available CV templates.</p></div>
        {% if manager %}<a class="btn btn-primary" href="{{ path('app_positions_new') }}">New position</a>{% endif %}
    </div>
    {% for message in app.flashes('success') %}<div class="alert alert-success" role="status">{{ message }}</div>{% endfor %}
    <div class="table-responsive border rounded bg-white">
        <table class="table table-striped align-middle mb-0">
            <thead><tr><th scope="col">Title</th><th scope="col">Access</th><th scope="col">Attributes</th><th scope="col">Project limit</th><th scope="col">Updated</th>{% if manager %}<th scope="col"><span class="visually-hidden">Actions</span></th>{% endif %}</tr></thead>
            <tbody>
            {% for position in positions %}
                <tr>
                    <td><a href="{{ path('app_positions_show', {id: position.id}) }}">{{ position.title }}</a></td>
                    <td>{{ position.accessType.value|capitalize }}</td>
                    <td>{{ position.attributes|length }}</td>
                    <td>{{ position.maxProjects }}</td>
                    <td>{{ position.updatedAt|date('Y-m-d') }}</td>
                    {% if manager %}<td class="text-end"><a class="btn btn-outline-primary btn-sm" href="{{ path('app_positions_edit', {id: position.id}) }}">Edit</a></td>{% endif %}
                </tr>
            {% else %}
                <tr><td colspan="{{ manager ? 6 : 5 }}" class="text-center text-body-secondary py-4">No Positions are available.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="small text-body-secondary mt-2">Showing up to 100 Positions.</p>
</main>
{% endblock %}
