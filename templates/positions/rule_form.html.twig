{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.new_access_rule'|trans }} · Itransition Project{% endblock %}
{% block body %}<main class="container py-4 py-lg-5"><a href="{{ path('app_positions_edit', {id: position.id}) }}">{{ 'ui.back_edit_position'|trans }}</a><h1 class="h2 my-4">{{ 'ui.new_access_rule'|trans }}</h1><p>{{ 'ui.attribute_colon'|trans }} <strong>{{ definition.name }}</strong> ({{ ('enum.type.' ~ definition.type.value)|trans }})</p><div class="card"><div class="card-body">{{ form_start(form) }}{{ form_errors(form) }}{{ form_widget(form) }}<button class="btn btn-primary mt-3">{{ 'ui.add_access_rule'|trans }}</button>{{ form_end(form) }}</div></div></main>{% endblock %}
