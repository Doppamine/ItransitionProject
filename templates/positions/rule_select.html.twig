{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.choose_rule_attribute'|trans }} · Itransition Project{% endblock %}
{% block body %}<main class="container py-4 py-lg-5"><a href="{{ path('app_positions_edit', {id: position.id}) }}">{{ 'ui.back_edit_position'|trans }}</a><h1 class="h2 my-4">{{ 'ui.choose_rule_attribute'|trans }}</h1><form method="get" class="card card-body"><label class="form-label" for="rule-definition">{{ 'ui.attribute'|trans }}</label><select id="rule-definition" class="form-select" name="definition" required><option value="">{{ 'ui.choose_attribute'|trans }}</option>{% for definition in definitions %}<option value="{{ definition.id }}">{{ definition.name }} ({{ ('enum.type.' ~ definition.type.value)|trans }})</option>{% endfor %}</select><button class="btn btn-primary mt-3 align-self-start">{{ 'ui.continue'|trans }}</button></form></main>{% endblock %}
