{% extends 'base.html.twig' %}

{% block title %}My Profile · Itransition Project{% endblock %}

{% block body %}
<main class="container py-4 py-lg-5 profile-page"
      data-controller="profile-autosave"
      data-profile-autosave-url-value="{{ path('app_profile_autosave') }}"
      data-profile-autosave-version-value="{{ profile.version }}"
      data-profile-autosave-token-value="{{ csrf_token('profile') }}"
      data-action="input->profile-autosave#changed change->profile-autosave#changed">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <p class="text-uppercase small fw-semibold text-primary mb-1">Candidate workspace</p>
            <h1 class="display-6 fw-semibold mb-1">Your profile</h1>
            <p class="text-body-secondary mb-0">Keep your details current. Edits save automatically every seven seconds.</p>
        </div>
        <div class="profile-save-state" role="status" aria-live="polite" data-profile-autosave-target="status">Saved</div>
    </div>

    <nav class="nav nav-pills gap-2 mb-4" aria-label="Profile sections">
        <a class="nav-link" href="#me">Me</a>
        <a class="nav-link" href="#info">Info</a>
    </nav>

    <section id="me" class="card shadow-sm border-0 mb-4" aria-labelledby="me-heading">
        <div class="card-body p-4 p-lg-5">
            <h2 id="me-heading" class="h4 mb-1">Me</h2>
            <p class="text-body-secondary mb-4">The essential details that identify you.</p>
            <div class="row g-4">
                {% for value in builtIns %}
                    <div class="col-12 {{ value.definition.type.value == 'image' ? '' : 'col-md-6' }}">
                        {% include 'profile/_editor.html.twig' with {value: value} only %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="info" class="card shadow-sm border-0" aria-labelledby="info-heading">
        <div class="card-body p-4 p-lg-5">
            <h2 id="info-heading" class="h4 mb-1">Info</h2>
            <p class="text-body-secondary mb-4">Choose the details that help describe your experience.</p>

            {% if optional is not empty %}
                <div class="row g-4 mb-5">
                    {% for value in optional %}
                        <div class="col-12 col-lg-6">
                            <div class="profile-optional-editor h-100">
                                {% include 'profile/_editor.html.twig' with {value: value} only %}
                                <form method="post" action="{{ path('app_profile_remove', {id: value.definition.id}) }}" data-action="submit->profile-autosave#guardNavigation">
                                    <input type="hidden" name="_token" value="{{ csrf_token('profile') }}">
                                    <button type="submit" class="btn btn-link btn-sm text-danger px-0 mt-2">Remove attribute</button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="profile-empty mb-5">No extra details yet. Find an attribute below to add one.</p>
            {% endif %}

            <div class="border-top pt-4">
                <h3 class="h5 mb-3">Add an attribute</h3>
                <form method="get" action="{{ path('app_profile') }}#info" class="row g-2 align-items-end mb-3" data-action="submit->profile-autosave#guardNavigation">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="attribute-search">Search by name</label>
                        <input id="attribute-search" name="q" class="form-control" value="{{ query }}" maxlength="100" placeholder="Start of attribute name">
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="attribute-category">Category</label>
                        <select id="attribute-category" name="category" class="form-select">
                            <option value="">All categories</option>
                            {% for category in categories %}
                                <option value="{{ category.id }}" {{ categoryId == category.id ? 'selected' : '' }}>{{ category.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12 col-md-2 d-grid"><button class="btn btn-outline-primary" type="submit">Find</button></div>
                </form>
                <div id="attribute-results" class="list-group list-group-flush border rounded-3 overflow-hidden">
                    {% for attribute in available %}
                        <div class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
                            <div><strong>{{ attribute.name }}</strong><span class="text-body-secondary small ms-2">{{ attribute.category }}</span></div>
                            <form method="post" action="{{ path('app_profile_select', {id: attribute.id}) }}" data-action="submit->profile-autosave#guardNavigation">
                                <input type="hidden" name="_token" value="{{ csrf_token('profile') }}">
                                <button type="submit" class="btn btn-outline-primary btn-sm">Add</button>
                            </form>
                        </div>
                    {% else %}
                        <p class="text-body-secondary p-3 mb-0">No available attributes match this search.</p>
                    {% endfor %}
                </div>
                <p class="small text-body-secondary mt-3 mb-0">Showing up to 20 available attributes.</p>
            </div>
        </div>
    </section>
</main>
{% endblock %}
