{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.search'|trans }} · Itransition Project{% endblock %}

{% block body %}
<main class="container py-4 py-lg-5">
    <h1 class="h2 mb-3">{{ 'ui.search'|trans }}</h1>
    {% if query == '' %}
        <p class="text-body-secondary">{{ 'ui.search_prompt'|trans }}</p>
    {% else %}
        <p class="text-body-secondary">{{ 'dynamic.search_results'|trans({'%query%': query}) }}</p>
        <h2 class="h4 mt-4">{{ 'ui.positions'|trans }}</h2>
        <div class="table-responsive border rounded-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th scope="col">{{ 'ui.position'|trans }}</th><th scope="col">{{ 'ui.access'|trans }}</th><th scope="col">{{ 'ui.updated'|trans }}</th></tr></thead>
                <tbody>
                    {% for position in positions %}
                        <tr><td><a href="{{ path('app_positions_show', {id: position.id}) }}">{{ position.title }}</a></td><td>{{ ('enum.access.' ~ position.accessType.value)|trans }}</td><td>{{ position.updatedAt|date('Y-m-d') }}</td></tr>
                    {% else %}
                        <tr><td colspan="3" class="text-body-secondary py-4">{{ 'ui.no_matching_positions'|trans }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if showCVs %}
            <h2 class="h4 mt-5">{{ 'ui.cvs'|trans }}</h2>
            <div id="cv-results" class="table-responsive border rounded-3">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th scope="col">{{ 'ui.candidate'|trans }}</th><th scope="col">{{ 'ui.position'|trans }}</th>{% if admin %}<th scope="col">{{ 'ui.status'|trans }}</th>{% endif %}<th scope="col">{{ 'ui.likes'|trans }}</th><th scope="col">{{ 'ui.updated'|trans }}</th></tr></thead>
                    <tbody>
                        {% for row in cvRows %}
                            <tr><td><a href="{{ path('app_cv_show', {id: row.cv.id}) }}">{{ row.candidateName }}</a></td><td>{{ row.cv.position.title }}</td>{% if admin %}<td>{{ ('enum.cv_status.' ~ row.cv.status.value)|trans }}</td>{% endif %}<td>{{ row.likeCount }}</td><td>{{ row.cv.updatedAt|date('Y-m-d') }}</td></tr>
                        {% else %}
                            <tr><td colspan="{{ admin ? 5 : 4 }}" class="text-body-secondary py-4">{{ 'ui.no_matching_cvs'|trans }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endif %}
</main>
{% endblock %}
