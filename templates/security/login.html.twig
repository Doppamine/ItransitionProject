{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.sign_in'|trans }} · Itransition Project{% endblock %}

{% block body %}
    <main class="container py-5">
        <div class="card shadow-sm mx-auto" style="max-width: 28rem">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">{{ 'auth.sign_in'|trans }}</h1>
                <p class="text-body-secondary">{{ 'auth.choose_provider'|trans }}</p>
                {% if loginError %}
                    <div class="alert alert-danger" role="alert">{{ 'auth.error'|trans }}</div>
                {% endif %}
                <div class="d-grid gap-2">
                    <a class="btn btn-outline-primary" href="{{ path('app_google_start') }}">{{ 'auth.google'|trans }}</a>
                    <a class="btn btn-outline-secondary" href="{{ path('app_github_start') }}">{{ 'auth.github'|trans }}</a>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
