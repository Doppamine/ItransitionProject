{% extends 'base.html.twig' %}

{% block title %}{{ 'support.title'|trans }} · Itransition Project{% endblock %}

{% block body %}
<main class="container py-4 py-lg-5">
    <h1 class="h2 mb-4">{{ 'support.title'|trans }}</h1>
    {% for message in app.flashes('success') %}
        {% if app.request.method == 'GET' %}<div class="alert alert-success" role="status">{{ message|trans }}</div>{% endif %}
    {% endfor %}
    <div class="card"><div class="card-body">
        {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.summary) }}
        {{ form_row(form.priority) }}
        <button class="btn btn-primary mt-4" type="submit">{{ 'support.submit'|trans }}</button>
        {{ form_end(form) }}
    </div></div>
</main>
{% endblock %}
